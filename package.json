{
  "name": "kws-multistream",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-stream viewer with Chatango chat",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "eu.raszei.multistream",
    "productName": "KWS MultiStream",
    "win": {
      "target": "nsis"
    },
    "files": [
      "out/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "esbuild@0.21.5": true
  }
}
